  {
    "id": "sound-i",
    "symbol": "/i/",
    "group": "vowel",
    "name": {
      "zh": "高前元音",
      "en": "High front vowel"
    },
    "tip": {
      "zh": "舌位高、靠前，唇自然展开；与 /ɪ/ 区别不只在长度。 先听单音，再用例词确认这个音在单词中的样子。",
      "en": "Keep the tongue high and forward. The difference from /ɪ/ is not just length. Audio plays example words containing this sound."
    },
    "examples": [
      {
        "word": "see",
        "ipa": "si",
        "meaning": "看见"
      },
      {
        "word": "green",
        "ipa": "ɡrin",
        "meaning": "绿色的"
      },
      {
        "word": "team",
        "ipa": "tim",
        "meaning": "队伍"
      }
